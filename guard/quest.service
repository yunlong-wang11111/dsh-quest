# quest.service —— Linux/macOS 上让 quest 常驻（systemd 用户单元）
#
# 为什么不用自己写监督脚本：systemd 就是监督器——重启策略、日志、开机自启全都内置，
# 比手写守护循环可靠。任务侧的崩溃存活（进程组、日志落盘）与此无关，quest 挂了任务照跑，
# systemd 把 quest 拉回来后它会按单元/账本自动认领。
#
# 安装（用户级，不需要 root）：
#   mkdir -p ~/.config/systemd/user
#   cp quest.service ~/.config/systemd/user/
#   # 改下面两处路径：WorkingDirectory 指向 quest 源码目录、Environment 里调端口/DSH 地址
#   systemctl --user daemon-reload
#   systemctl --user enable --now quest
#   loginctl enable-linger $USER     # 允许未登录时也运行
#
# 查看：
#   systemctl --user status quest
#   journalctl --user -u quest -f

[Unit]
Description=quest - agent-agnostic research pipeline orchestrator
# 只在 DSH 存在时才有 daemon-reload 依赖；quest 本身可在无 DSH 的机械模式下独立运行，
# 所以这里不写 Requires/After，避免把两者耦合。

[Service]
Type=simple
# 改成你的 quest 源码目录（含 server.mjs）
WorkingDirectory=%h/quest
ExecStart=/usr/bin/env node server.mjs

# 常用调参：端口、DSH 地址、数据目录；令牌默认取 $QUEST_HOME/.token
Environment=QUEST_PORT=3110
# Environment=QUEST_DSH=http://127.0.0.1:3080
# Environment=QUEST_HOME=%h/.dsh/quests

# 崩溃/被杀自动重启；quest 有账本与认领逻辑，重启是安全的
Restart=always
RestartSec=5
# 重启风暴保护：5 分钟内超过 10 次就停下（问题不会因重启而自愈时不要空转）
StartLimitIntervalSec=300
StartLimitBurst=10

StandardOutput=append:%h/.dsh/quests/quest-stdout.log
StandardError=append:%h/.dsh/quests/quest-stderr.log

[Install]
WantedBy=default.target
